# Copy to .env (git-ignored) and fill in. Never commit real values.

# Meta Model API (Muse Spark)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Muse Spark reasons before answering: reasoning tokens count toward this cap.
MAX_TOKENS=8192
MAX_RETRIES=3

# Which provider runs Muse Spark: meta (above) or baseten (open-weights Muse Spark Open).
# Same as --provider on the CLI.
LLM_PROVIDER=meta
BASETEN_API_KEY=
# Optional overrides: BASETEN_BASE_URL (default https://inference.baseten.co/v1),
# BASETEN_MODEL (default meta-models/muse-spark-open),
# BASETEN_MAX_TOKENS (default 16384: reasoning tokens count toward it),
# BASETEN_REASONING_EFFORT (default medium; Baseten's own default is xhigh)

# Live devices (lab/devnet.yml): credentials of your Cisco DevNet sandbox reservation
DEVNET_USERNAME=
DEVNET_PASSWORD=
