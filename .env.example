# Copy to .env (git-ignored) and fill in. Never commit real values.

# Meta Model API (Muse Spark)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Muse Spark reasons before answering: reasoning tokens count toward this cap.
MAX_TOKENS=8192
MAX_RETRIES=3

# Any OpenAI-compatible endpoint serving Muse Spark Open works the same way, e.g.:
# META_API_BASE_URL=https://inference.baseten.co/v1
# META_MODEL=meta-models/muse-spark-open-1026

# Live devices (lab/devnet.yml): credentials of your Cisco DevNet sandbox reservation
DEVNET_USERNAME=
DEVNET_PASSWORD=
